{
  "manifest_version": 3,
  "name": "Instaloader Downloader",
  "version": "1.1.0",
  "description": "Adds a download button to Instagram posts, reels and saved items; sends them to your local instaloader server.",
  "permissions": ["cookies", "storage", "alarms"],
  "host_permissions": ["https://www.instagram.com/*"],
  "background": { "service_worker": "background.js" },
  "action": {
    "default_title": "Instaloader Downloader",
    "default_popup": "popup.html"
  },
  "content_scripts": [
    {
      "matches": ["https://www.instagram.com/*"],
      "js": ["content.js"],
      "css": ["content.css"],
      "run_at": "document_idle"
    }
  ]
}
